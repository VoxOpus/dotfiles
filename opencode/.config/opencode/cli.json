{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-frappe"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "markdown": "rendered",
    "thinking": "show",
    "grouping": "auto",
    "verbosity": "high"
  },
  "tabs": {
    "mode": "auto",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "numbers"
  },
  "terminal": {
    "copy": "select"
  },
  "attention": {
    "sound": true,
    "notifications": true
  },
  "prompt": {
    "paste": "compact",
    "editor": true
  },
  "mouse": true,
  "scroll": {
    "acceleration": true
  },
  "diffs": {
    "view": "auto",
    "wrap": "word",
    "tree": true,
    "single": false
  },
  "debug": {
    "devtools": true,
    "turn_tokens": false,
    "timing": false
  }
}
