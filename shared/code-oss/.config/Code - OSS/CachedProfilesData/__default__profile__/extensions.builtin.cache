ons/dotenv","scheme":"file"},"isBuiltin":true,"targetPlatform":"undefined","isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":0,"identifier":{"id":"vscode.emmet"},"manifest":{"name":"emmet","displayName":"Emmet","description":"Emmet-Unterstützung für VS Code","version":"10.0.0","publisher":"vscode","license":"MIT","engines":{"vscode":"^1.13.0"},"icon":"images/icon.png","categories":["Other"],"repository":{"type":"git","url":"https://github.com/microsoft/vscode.git"},"activationEvents":["onCommand:emmet.expandAbbreviation","onLanguage"],"main":"./dist/node/emmetNodeMain","browser":"./dist/browser/emmetBrowserMain","contributes":{"configuration":{"type":"object","title":"Emmet","properties":{"emmet.showExpandedAbbreviation":{"type":["string"],"enum":["never","always","inMarkupAndStylesheetFilesOnly"],"default":"always","markdownDescription":"Zeigt erweiterte Emmet-Abkürzungen als Vorschläge an.\r\nDie Option \"inMarkupAndStylesheetFilesOnly\" gilt für: html, haml, jade, slim, xml, xsl, css, scss, sass, less, stylus.\r\nDie Option \"always\" gilt unabhängig von Markup/CSS für alle Teile der Datei."},"emmet.showAbbreviationSuggestions":{"type":"boolean","default":true,"scope":"language-overridable","markdownDescription":"Zeigt mögliche Emmet-Abkürzungen als Vorschläge an. Diese Option gilt nicht in Stylesheets oder wenn emmet.showExpandedAbbreviation auf `\"never`\" festgelegt ist."},"emmet.includeLanguages":{"type":"object","additionalProperties":{"type":"string"},"default":{},"markdownDescription":"Aktivieren Sie Emmet-Abkürzungen in Sprachen, die nicht standardmäßig unterstützt werden. Fügen Sie hier eine Zuordnung zwischen der unterstützten Sprache und der unterstützten Emmet-Sprache hinzu.\r\n Beispiel: {\"vue-html\": \"html\", \"javascript\": \"javascriptreact\"}"},"emmet.variables":{"type":"object","properties":{"lang":{"type":"string","default":"en"},"charset":{"type":"string","default":"UTF-8"}},"additionalProperties":{"type":"string"},"default":{},"markdownDescription":"In Emmet-Schnipseln zu verwendende Codeschnipsel."},"emmet.syntaxProfiles":{"type":"object","default":{},"markdownDescription":"Definieren Sie das Profil für die angegebene Syntax, oder verwenden Sie Ihr eigenes Profil mit bestimmten Regeln."},"emmet.excludeLanguages":{"type":"array","items":{"type":"string"},"default":["markdown"],"markdownDescription":"Ein Array von Sprachen, in dem Emmet-Abkürzungen nicht erweitert werden sollten."},"emmet.extensionsPath":{"type":"array","items":{"type":"string","markdownDescription":"Ein Pfad, der Emmet-syntaxProfiles und/oder-Schnipsel enthält."},"default":[],"scope":"machine-overridable","markdownDescription":"Ein Array von Pfaden, in dem jeder Pfad Emmet-syntaxProfiles und/oder Schnipseldateien enthalten kann.\r\nBei Konflikten überschreiben die Profile/Schnipsel der späteren Pfade die der früheren Pfade.\r\nWeitere Informationen und eine Beispielschnipseldatei finden Sie unter https://code.visualstudio.com/docs/editor/emmet."},"emmet.triggerExpansionOnTab":{"type":"boolean","default":false,"scope":"language-overridable","markdownDescription":"Wenn diese Option aktiviert ist, werden Emmet-Abkürzungen beim Drücken der TAB-TASTE erweitert, auch wenn keine Vervollständigungen angezeigt werden. Wenn diese Option deaktiviert ist, können Vervollständigungen, die angezeigt werden, weiterhin durch Drücken der TAB-TASTE akzeptiert werden."},"emmet.useInlineCompletions":{"type":"boolean","default":false,"markdownDescription":"Wenn \"true\", verwendet Emmet Inline-Vervollständigungen, um Erweiterungen vorzuschlagen. Um zu verhindern, dass der Nicht-Inline-Vervollständigungselementanbieter so oft angezeigt wird, während diese Einstellung auf „true“ gesetzt ist, schalten Sie „#editor.quickSuggestions#“ für das „andere“ Element auf „inline“ oder „off“."},"emmet.preferences":{"type":"object","default":{},"markdownDescription":"Einstellungen, die zum Ändern des Verhaltens einiger Aktionen und Konfliktlöser von Emmet verwendet werden.","properties":{"css.intUnit":{"type":"string","default":"px","markdownDescription":"Standardeinheit für Integerwerte."},"css.floatUnit":{"type":"string","default":"em","markdownDescription":"Standardeinheit für Floatwerte."},"css.propertyEnd":{"type":"string","default":";","markdownDescription":"Symbol, das beim Erweitern von CSS-Abkürzungen am Ende der CSS-Eigenschaft eingefügt werden soll."},"sass.propertyEnd":{"type":"string","default":"","markdownDescription":"Symbol, das beim Erweitern von CSS-Abkürzungen in Sass-Dateien am Ende der CSS-Eigenschaft eingefügt werden soll."},"stylus.propertyEnd":{"type":"string","default":"","markdownDescription":"Symbol, das beim Erweitern von CSS-Abkürzungen in Stylus-Dateien am Ende der CSS-Eigenschaft eingefügt werden soll."},"css.valueSeparator":{"type":"string","default":": ","markdownDescription":"Symbol, das beim Erweitern von CSS-Abkürzungen zwischen der CSS-Eigenschaft und dem Wert eingefügt werden soll."},"sass.valueSeparator":{"type":"string","default":": ","markdownDescription":"Symbol, das beim Erweitern von CSS-Abkürzungen in Sass-Dateien zwischen der CSS-Eigenschaft und dem Wert eingefügt werden soll."},"stylus.valueSeparator":{"type":"string","default":" ","markdownDescription":"Symbol, das beim Erweitern von CSS-Abkürzungen in Stylus-Dateien zwischen der CSS-Eigenschaft und dem Wert eingefügt werden soll."},"bem.elementSeparator":{"type":"string","default":"__","markdownDescription":"Elementtrennzeichen für Klassen unter Verwendung des BEM-Filters."},"bem.modifierSeparator":{"type":"string","default":"_","markdownDescription":"Modifizierertrennzeichen für Klassen unter Verwendung des BEM-Filters."},"filter.commentBefore":{"type":"string","default":"","markdownDescription":"Eine Kommentardefinition, die vor dem abgeglichenen Element platziert werden muss, wenn ein Kommentarfilter angewendet wird."},"filter.commentAfter":{"type":"string","default":"\n<!-- /[#ID][.CLASS] -->","markdownDescription":"Eine Kommentardefinition, die nach dem abgeglichenen Element platziert werden muss, wenn ein Kommentarfilter angewendet wird."},"filter.commentTrigger":{"type":"array","default":["id","class"],"markdownDescription":"Eine durch Trennzeichen getrennte Liste von Attributnamen, die in abgekürzter Form vorliegen müssen, damit der Kommentarfilter angewendet werden kann."},"format.noIndentTags":{"type":"array","default":["html"],"markdownDescription":"Ein Array von Tagnamen, die nie einen inneren Einzug erhalten."},"format.forceIndentationForTags":{"type":"array","default":["body"],"markdownDescription":"Ein Array von Tagnamen, die immer einen inneren Einzug erhalten."},"profile.allowCompactBoolean":{"type":"boolean","default":false,"markdownDescription":"Bei TRUE wird eine kompakte Notation boolescher Attribute erzeugt."},"css.webkitProperties":{"type":"string","default":null,"markdownDescription":"Durch Trennzeichen getrennte CSS-Eigenschaften, die das `webkit`-Herstellerpräfix erhalten, wenn sie in einer Emmet-Abkürzung verwendet werden, die mit `-` beginnt. Legen Sie eine leere Zeichenfolge fest, um das `webkit`-Präfix immer zu vermeiden."},"css.mozProperties":{"type":"string","default":null,"markdownDescription":"Durch Trennzeichen getrennte CSS-Eigenschaften, die das `moz`-Herstellerpräfix erhalten, wenn sie in einer Emmet-Abkürzung verwendet werden, die mit `-` beginnt. Legen Sie eine leere Zeichenfolge fest, um das `moz`-Präfix immer zu vermeiden."},"css.oProperties":{"type":"string","default":null,"markdownDescription":"Durch Trennzeichen getrennte CSS-Eigenschaften, die das `o`-Herstellerpräfix erhalten, wenn sie in einer Emmet-Abkürzung verwendet werden, die mit `-` beginnt. Legen Sie eine leere Zeichenfolge fest, um das `o`-Präfix immer zu vermeiden."},"css.msProperties":{"type":"string","default":null,"markdownDescription":"Durch Trennzeichen getrennte CSS-Eigenschaften, die das `ms`-Herstellerpräfix erhalten, wenn sie in einer Emmet-Abkürzung verwendet werden, die mit `-` beginnt. Legen Sie eine leere Zeichenfolge fest, um das `ms`-Präfix immer zu vermeiden."},"css.fuzzySearchMinScore":{"type":"number","default":0.3,"markdownDescription":"Das Mindestergebnis (zwischen 0 und 1), das die Abkürzung mit Fuzzyübereinstimmung erreichen muss. Niedrigere Werte führen zu vielen falsch positiven Übereinstimmungen, höhere Werte verringern unter Umständen die möglichen Übereinstimmungen."},"output.inlineBreak":{"type":"number","default":0,"markdownDescription":"Die Anzahl gleichgeordneter Inline-Elemente, die erforderlich sind, damit Zeilenumbrüche zwischen diesen Elementen eingefügt werden. Bei \"0\" werden Inline-Elemente immer auf einer einzigen Zeile platziert."},"output.reverseAttributes":{"type":"boolean","default":false,"markdownDescription":"Bei TRUE werden beim Auflösen von Schnipseln die Richtungen von Attributzusammenführungen umgekehrt."},"output.selfClosingStyle":{"type":"string","enum":["html","xhtml","xml"],"default":"html","markdownDescription":"Formatvorlage der selbstschließenden Tags: HTML („<br>“), XML („<br/>“) oder XHTML („<br />“)."},"css.color.short":{"type":"boolean","default":true,"markdownDescription":"Bei „true“ werden Farbwerte wie `#f auf `#fff anstelle von `#ffffff erweitert."}}},"emmet.showSuggestionsAsSnippets":{"type":"boolean","default":false,"markdownDescription":"Bei TRUE werden die Emmet-Vorschläge als Schnipsel angezeigt. Dadurch können Sie die Vorschläge entsprechend der `#editor.snippetSuggestions#`-Einstellung anordnen."},"emmet.optimizeStylesheetParsing":{"type":"boolean","default":true,"markdownDescription":"Bei FALSE wird die gesamte Datei analysiert, um zu ermitteln, ob das Erweitern von Emmet-Abkürzungen an der aktuellen Position möglich ist. Bei TRUE wird nur der Inhalt vor und nach der aktuellen Position in CSS-, SCSS-, und LESS-Dateien analysiert."}}},"commands":[{"command":"editor.emmet.action.wrapWithAbbreviation","title":{"value":"Mit Abkürzung umschließen","original":"Wrap with Abbreviation"},"category":"Emmet"},{"command":"editor.emmet.action.removeTag","title":{"value":"Tag entfernen","original":"Remove Tag"},"category":"Emmet"},{"command":"editor.emmet.action.updateTag","title":{"value":"Tag aktualisieren","original":"Update Tag"},"category":"Emmet"},{"command":"editor.emmet.action.matchTag","title":{"value":"Gehe zu übereinstimmendem Paar","original":"Go to Matching Pair"},"category":"Emmet"},{"command":"editor.emmet.action.balanceIn","title":{"value":"Ausgleichen (einwärts)","original":"Balance (inward)"},"category":"Emmet"},{"command":"editor.emmet.action.balanceOut","title":{"value":"Ausgleichen (auswärts)","original":"Balance (outward)"},"category":"Emmet"},{"command":"editor.emmet.action.prevEditPoint","title":{"value":"Gehe zum vorherigen Bearbeitungspunkt","original":"Go to Previous Edit Point"},"category":"Emmet"},{"command":"editor.emmet.action.nextEditPoint","title":{"value":"Gehe zum nächsten Bearbeitungspunkt","original":"Go to Next Edit Point"},"category":"Emmet"},{"command":"editor.emmet.action.mergeLines","title":{"value":"Zeilen mergen","original":"Merge Lines"},"category":"Emmet"},{"command":"editor.emmet.action.selectPrevItem","title":{"value":"Vorheriges Element auswählen","original":"Select Previous Item"},"category":"Emmet"},{"command":"editor.emmet.action.selectNextItem","title":{"value":"Nächstes Element auswählen","original":"Select Next Item"},"category":"Emmet"},{"command":"editor.emmet.action.splitJoinTag","title":{"value":"Tag teilen/verknüpfen","original":"Split/Join Tag"},"category":"Emmet"},{"command":"editor.emmet.action.toggleComment","title":{"value":"Kommentar ein-/ausschalten","original":"Toggle Comment"},"category":"Emmet"},{"command":"editor.emmet.action.evaluateMathExpression","title":{"value":"Mathematischen Ausdruck auswerten","original":"Evaluate Math Expression"},"category":"Emmet"},{"command":"editor.emmet.action.updateImageSize","title":{"value":"Bildgröße aktualisieren"