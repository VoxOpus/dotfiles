command":"git.stash","group":"1_stash@1"},{"command":"git.stashIncludeUntracked","group":"1_stash@2"},{"command":"git.stashStaged","when":"gitVersion2.35","group":"1_stash@3"},{"command":"git.stashApplyLatest","group":"2_apply@1"},{"command":"git.stashApply","group":"2_apply@2"},{"command":"git.stashPopLatest","group":"3_pop@1"},{"command":"git.stashPop","group":"3_pop@2"},{"command":"git.stashDrop","group":"4_drop@1"},{"command":"git.stashDropAll","group":"4_drop@2"},{"command":"git.stashView","group":"5_preview@1"}],"git.repositories.stash":[{"command":"git.stash","group":"1_stash@1"},{"command":"git.stashStaged","when":"gitVersion2.35","group":"2_stash@1"},{"command":"git.stashIncludeUntracked","group":"2_stash@2"}],"git.tags":[{"command":"git.createTag","group":"1_tags@1"},{"command":"git.deleteTag","group":"1_tags@2"},{"command":"git.deleteRemoteTag","group":"1_tags@3"},{"command":"git.pushTags","group":"2_tags@1"}],"git.worktrees":[{"when":"scmProviderContext == worktree","command":"git.openWorktree","group":"openWorktrees@1"},{"when":"scmProviderContext == worktree","command":"git.openWorktreeInNewWindow","group":"openWorktrees@2"},{"when":"scmProviderContext == repository","command":"git.createWorktree","group":"worktrees@1"},{"when":"scmProviderContext == worktree","command":"git.deleteWorktree2","group":"worktrees@2"}]},"submenus":[{"id":"git.commit","label":"Commit"},{"id":"git.changes","label":"Änderungen"},{"id":"git.pullpush","label":"Pull, Push"},{"id":"git.branch","label":"Branch"},{"id":"git.remotes","label":"Remote"},{"id":"git.stash","label":"Stash ausführen"},{"id":"git.tags","label":"Tags"},{"id":"git.worktrees","label":"Worktrees"},{"id":"git.repositories.stash","label":"Stash ausführen","icon":"$(plus)"}],"configuration":{"title":"Git","properties":{"git.enabled":{"type":"boolean","scope":"resource","description":"Legt fest, ob Git aktiviert ist.","default":true,"agentsWindow":{"default":true,"readOnly":true}},"git.path":{"type":["string","null","array"],"markdownDescription":"Der Pfad und der Dateiname der ausführbaren Git-Datei, beispielsweise \"C:\\Programme\\Git\\bin\\git.exe\" (Windows). Hierbei kann es sich auch um Array mit Zeichenfolgenwerten handeln, die mehrere Pfade für die Suche enthalten.","default":null,"scope":"machine"},"git.autoRepositoryDetection":{"type":["boolean","string"],"enum":[true,false,"subFolders","openEditors"],"enumDescriptions":["Sowohl nach Unterordnern des aktuell geöffneten Ordners als auch nach übergeordneten Ordnern von geöffneten Dateien suchen.","Automatisches Durchsuchen von Repositorys deaktiveren.","Nach Unterordnern des aktuell geöffneten Ordners suchen.","Nach übergeordneten Ordnern von geöffneten Dateien suchen."],"description":"Legt fest, in welchen Fällen Repositorys automatisch erkannt werden sollen.","default":true},"git.autorefresh":{"type":"boolean","description":"Gibt an, ob die automatische Aktualisierung aktiviert ist.","default":true,"agentsWindow":{"default":true}},"git.autofetch":{"type":["boolean","string"],"enum":[true,false,"all"],"scope":"resource","markdownDescription":"Bei Festlegung auf TRUE werden Commits automatisch aus dem Standardremoteverzeichnis des aktuellen Git-Repositorys abgerufen. Bei Festlegung auf \"Alle\" erfolgt der Abruf aus allen Remoteverzeichnissen.","default":false,"tags":["usesOnlineServices"],"agentsWindow":{"default":true}},"git.autofetchPeriod":{"type":"number","scope":"resource","markdownDescription":"Dauer in Sekunden zwischen jeder automatischen Git-Abrufung, wenn \"#git.autofetch#\" aktiviert ist.","default":180},"git.defaultBranchName":{"type":"string","markdownDescription":"Der Name des Standardbranchs (z. B. main, trunk, development) beim Initialisieren eines neuen Git-Repositorys. Bei Festlegung auf \"empty\" wird der in Git konfigurierte Standardbranchname verwendet. **Hinweis:** Erfordert Git-Version 2.28.0 oder höher.","default":"main","scope":"resource"},"git.branchPrefix":{"type":"string","description":"Präfix, das beim Erstellen einer neuen Verzweigung verwendet wird.","default":"","scope":"resource"},"git.branchProtection":{"type":"array","markdownDescription":"Liste der geschützten Verzweigungen. Standardmäßig wird eine Eingabeaufforderung angezeigt, bevor ein Commit für Änderungen für eine geschützte Verzweigung ausgeführt wird. Die Eingabeaufforderung kann mithilfe der Einstellung „#git.branchProtectionPrompt#“ gesteuert werden.","items":{"type":"string"},"default":[],"scope":"resource"},"git.branchProtectionPrompt":{"type":"string","description":"Steuert, ob eine Eingabeaufforderung angezeigt wird, bevor ein Commit für Änderungen an einen geschützten Branch ausgeführt wird.","enum":["alwaysCommit","alwaysCommitToNewBranch","alwaysPrompt"],"enumDescriptions":["Der Commit für Änderungen muss immer für die geschützte Verzweigung ausgeführt werden.","Der Commit für Änderungen muss immer für eine neue Verzweigung ausgeführt werden.","Immer fragen, bevor für Änderungen ein Commit für eine geschützte Verzweigung ausgeführt wird."],"default":"alwaysPrompt","scope":"resource"},"git.branchValidationRegex":{"type":"string","description":"Regulärer Ausdruck zum Validieren neuer Branch-Namen.","default":""},"git.branchWhitespaceChar":{"type":"string","description":"Das Zeichen, das Leerzeichen in neuen Verzweigungsnamen ersetzen und Segmente eines zufällig generierten Verzweigungsnamens trennen soll.","default":"-"},"git.branchRandomName.enable":{"type":"boolean","description":"Steuert, ob beim Erstellen einer neuen Verzweigung ein zufälliger Name generiert wird.","default":false,"scope":"resource","agentsWindow":{"default":true}},"git.branchRandomName.dictionary":{"type":"array","markdownDescription":"Liste der Wörterbücher, die für den zufällig generierten Zweignamen verwendet werden. Jeder Wert stellt das Wörterbuch dar, das zum Generieren des Segments des Zweignamens verwendet wird. Unterstützte Wörterbücher: „Adjektive“, „Tiere“, „Farben“ und „Zahlen“.","items":{"type":"string","enum":["adjectives","animals","colors","numbers"],"enumDescriptions":["Ein zufälliges Adjektiv","Ein zufälliger Tiername","Ein zufälliger Farbname","Eine Zufallszahl zwischen 100 und 999"]},"minItems":1,"maxItems":5,"default":["adjectives","animals"],"scope":"resource"},"git.confirmSync":{"type":"boolean","description":"Bestätigen Sie den Vorgang vor dem Synchronisieren von Git-Repositorys.","default":true,"agentsWindow":{"default":false,"readOnly":true}},"git.confirmCommittedDelete":{"type":"boolean","description":"Bestätigen Sie dies, bevor Sie committete Dateien mit Git löschen.","default":true},"git.countBadge":{"type":"string","enum":["all","tracked","off"],"enumDescriptions":["Alle Änderungen zählen.","Nur nachverfolgte Änderungen zählen.","Zähler deaktivieren."],"description":"Steuert den Git-Anzahlbadge.","default":"all","scope":"resource"},"git.checkoutType":{"type":"array","items":{"type":"string","enum":["local","tags","remote"],"enumDescriptions":["Lokale Branches","Tags","Remotebranches"]},"uniqueItems":true,"markdownDescription":"Legt fest, welche Art von Git-Referenzen bei Ausführung von \"Check-Out nach\" aufgelistet wird.","default":["local","remote","tags"]},"git.ignoreLegacyWarning":{"type":"boolean","description":"Ignoriert die Legacy-Git-Warnung.","default":false},"git.ignoreMissingGitWarning":{"type":"boolean","description":"Ignoriert die Warnung, wenn Git nicht vorhanden ist.","default":false},"git.ignoreWindowsGit27Warning":{"type":"boolean","description":"Ignoriert die Warnung, wenn Git 2.25–2.26 unter Windows installiert ist.","default":false},"git.ignoreLimitWarning":{"type":"boolean","description":"Ignoriert die Warnung bei zu hoher Anzahl von Änderungen in einem Repository.","default":false},"git.ignoreRebaseWarning":{"type":"boolean","description":"Ignoriert die Warnung beim Pullvorgang, wenn für den Branch möglicherweise ein Rebase ausgeführt wurde.","default":false},"git.defaultCloneDirectory":{"type":["string","null"],"default":null,"scope":"machine","description":"Der Standardspeicherort zum Klonen eines Git-Repositorys."},"git.useEditorAsCommitInput":{"type":"boolean","description":"Steuert, ob ein Volltext-Editor zum Erstellen von Commitnachrichten verwendet wird, wenn im Eingabefeld für den Commit keine Nachricht bereitgestellt wird.","default":true},"git.verboseCommit":{"type":"boolean","scope":"resource","markdownDescription":"Aktivieren Sie die ausführliche Ausgabe, wenn \"#git.useEditorAsCommitInput#\" aktiviert ist.","default":false},"git.enableSmartCommit":{"type":"boolean","scope":"resource","description":"Alle Änderungen committen, wenn keine gestageten Änderungen vorhanden sind.","default":false},"git.smartCommitChanges":{"type":"string","enum":["all","tracked"],"enumDescriptions":["Hiermit werden alle Änderungen automatisch gestaget.","Es wurden nur nachverfolgte Änderungen automatisch gestaget."],"scope":"resource","description":"Hiermit steuern Sie, welche Änderungen beim intelligenten Commit automatisch gestaget werden.","default":"all"},"git.suggestSmartCommit":{"type":"boolean","scope":"resource","description":"Schlägt das Aktivieren intelligenter Commits vor. Dabei werden alle Änderungen committet, wenn keine gestageten Änderungen vorliegen.","default":true},"git.enableCommitSigning":{"type":"boolean","scope":"resource","description":"Aktiviert die Commitsignatur mit GPG, X.509 oder SSH.","default":false},"git.confirmEmptyCommits":{"type":"boolean","scope":"resource","description":"Bestätigen Sie die Erstellung leerer Commits für den Befehl \"Git: Commit Empty\" immer.","default":true},"git.decorations.enabled":{"type":"boolean","default":true,"description":"Legt fest, ob Git Farben und Badges für die Explorer-Ansicht und die Ansicht \"Geöffnete Editoren\" bereitstellt."},"git.enableStatusBarSync":{"type":"boolean","default":true,"description":"Steuert, ob der Git Sync-Befehl in der Statusleiste angezeigt wird.","scope":"resource"},"git.followTagsWhenSync":{"type":"boolean","scope":"resource","default":false,"description":"Übertragen Sie alle annotierten Tags per Push, wenn der Synchronisierungsbefehl ausgeführt wird."},"git.replaceTagsWhenPull":{"type":"boolean","scope":"resource","default":false,"description":"Bei einem Konflikt beim Ausführen des Pull-Befehls werden die lokalen Tags automatisch durch die Remotetags ersetzt."},"git.promptToSaveFilesBeforeStash":{"type":"string","enum":["always","staged","never"],"enumDescriptions":["Hiermit prüfen Sie auf nicht gespeicherte Dateien.","Hiermit prüfen Sie nur auf nicht gespeicherte gestagete Dateien.","Hiermit wird diese Prüfung deaktiviert."],"scope":"resource","default":"always","description":"Legt fest, ob Git vor dem Stashen von Änderungen nach nicht gespeicherten Dateien suchen soll."},"git.promptToSaveFilesBeforeCommit":{"type":"string","enum":["always","staged","never"],"enumDescriptions":["Hiermit prüfen Sie auf nicht gespeicherte Dateien.","Hiermit prüfen Sie nur auf nicht gespeicherte gestagete Dateien.","Deaktiviert diese Prüfung."],"scope":"resource","default":"always","description":"Legt fest, ob Git vor dem einchecken nach nicht gespeicherten Dateien suchen soll."},"git.postCommitCommand":{"type":"string","enum":["none","push","sync"],"enumDescriptions":["Führen Sie keinen Befehl nach einem Commit aus.","\"Git push\" nach einem erfolgreichen Commit ausführen.","\"Git pull\" und \"git push\" nach einem erfolgreichen Commit ausführen."],"markdownDescription":"Git-Befehl nach erfolgreichem Commit ausführen.","scope":"resource","default":"none","agentsWindow":{"default":"none","readOnly":true}},"git.rememberPostCommitCommand":{"type":"boolean","description":"Den letzten Git-Befehl speichern, der nach einem Commit ausgeführt wurde.","scope":"resource","default":false,"agentsWindow":{"default":false,"readOnly":true}},"git.openAfterClone":{"type":"string","enum":["always","alwaysNewWindow","whenNoFolderOpen","prompt"],"enumDescriptions":["Öffnet Elemente immer im aktuellen Fenster.","Öffnet Elemente immer in einem neuen Fenster.","Öffnet Elemente nur dann im aktuellen Fenster, wenn kein Ordner geöffnet ist.","Fordert immer eine Aktion an."],"default":"prompt","description":"Steuert, ob ein Repository nach dem Klonen automatisch geöffnet wird."},"git.showInlineOpenFileAction":{"type":"boolean","default":true,"description":"Steuert, ob eine Inlineaktion zum Öffnen der Datei in der Ansicht \"Git-Änderungen\" angezeigt wird."},"git.showPushSuccessNotification":{"type":"boolean","description":"Legt fest, ob bei einem erfolgreichen Push eine Benachrichtigung angezeigt werden soll.","default":false},"git.inputValidation":{"type":"boolean","default":false,"description":"Steuert, ob eine Diagnose zur Validierung der Eingaben von Commitnachrichten angezeigt werden soll."},"git.inputValidationLength":{"type":"number","default":72,"description":"Steuert, ab welcher Länge für Commit-Nachrichten eine Warnung eingeblendet werden soll."},"git.inputValidationSubjectLength":{"type":["number","null"],"default":50,"markdownDescription":"Steuert den Schwellenwert für die Länge des Betreffs einer Commitnachricht, ab dem eine Warnung angezeigt wird. Heben Sie die Festlegung auf, um den Wert von \"#git.inputValidationLength#\" zu erben."},"git.detectSubmodules":{"type":"boolean","scope":"resource","default":true,"description":"Steuert, ob Git-Submodule automatisch erkannt werden."},"git.detectSubmodulesLimit":{"type":"number","scope":"resource","default":10,"description":"Steuert den Grenzwert für erkannte Git-Submodule."},"git.detectWorktrees":{"type":"boolean","scope":"resource","default":false,"description":"Steuert, ob Git-Worktrees automatisch erkannt werden.","agentsWindow":{"default":false}},"git.detectWorktreesLimit":{"type":"number","scope":"resource","default":50,"description":"Steuert den Grenzwert der erkannten Git-Worktrees."},"git.worktreeIncludeFiles":{"type":"array","items":{"type":"string"},"default":[],"markdownDescription":"Konfigurieren Sie [Glob-Muster](https://aka.ms/vscode-glob-patterns) für Dateien und Ordner, die beim Erstellen einer neuen Arbeitsstruktur einbezogen werden. Nur Dateien und Ordner, die den Mustern entsprechen und nicht in `.gitignore` aufgeführt sind, werden in die neu erstellte Arbeitsstruktur kopiert.","scope":"resource","tags":["experimental"]},"git.alwaysShowStagedChangesResourceGroup":{"type":"boolean","scope":"resource","default":false,"description":"Ressourcengruppe für gestagete Änderungen immer anzeigen."},"git.alwaysSignOff":{"type":"boolean","scope":"resource","default":false,"description":"Legt das signoff-Flag für alle Commits fest."},"git.addAICoAuthor":{"type":"string","enum":["off","chatAndAgent","all"],"enumDescriptions":["Den Trailer für den KI-Mitautor niemals hinzufügen.","Fügen Sie den KI-Mitautor-Trailer hinzu, wenn Code aus Chat- oder Agentenbearbeitungen enthalten ist.","Fügen Sie den KI-Mitautor-Trailer hinzu, wenn KI-generierter Code enthalten ist, wie zum Beispiel Inlinevervollständigungen, Chat oder Agentenbearbeitungen."],"scope":"resource","default":"off","description":"Legt fest, ob der Commitnachricht automatisch ein „Mitautor“-Trailer hinzugefügt wird, wenn KI-generierter Code im Commit enthalten ist."},"git.ignoreSubmodules":{"type":"boolean","scope":"resource","default":false,"description":"Ignoriert Änderungen an Untermodulen in der Dateistruktur."},"git.ignoredRepositories":{"type":"array","items":{"type":"string"},"default":[],"scope":"window","description":"Liste der zu ignorierenden Git-Repositorys."},"git.scanRepositories":{"type":"array","items":{"type":"string"},"default":[],"scope":"resource","description":"Liste mit Pfaden, in denen nach Git-Repositorys gesucht wird."},"git.showProgress":{"type":"boolean","description":"Steuert, ob für Git-Aktionen der Fortschritt zu sehen ist.","default":true,"scope":"resource","agentsWindow":{"default":false,"readOnly":true}},"git.rebaseWhenSync":{"type":"boolean","scope":"resource","default":false,"description":"Erzwingt, dass Git „rebase“ verwendet, wenn der Synchronisierungsbefehl ausgeführt wird."},"git.pullBeforeCheckout":{"type":"boolean","scope":"resource","default":false,"description":"Steuert, ob ein Branch ohne ausgehende Commits vor dem Auschecken schnell weitergeleitet wird."},"git.fetchOnPull":{"type":"boolean","scope":"resource","default":false,"description":"Wenn aktiviert, beim Pullen alle Branches abrufen. Andernfalls nur den aktuellen abrufen."},"git.pruneOnFetch":{"type":"boolean","scope":"resource","default":false,"description":"Löscht Elemente beim Abrufen."},"git.pullTags":{"type":"boolean","scope":"resource","default":true,"description":"Hiermit werden alle Tags beim Pullvorgang abgerufen."},"git.autoStash":{"type":"boolean","scope":"resource","default":false,"description":"Führen Sie für Änderungen einen Stash aus, bevor Sie sie pullen, und stellen Sie sie nach einem erfolgreichen Pull wieder her."},"git.allowForcePush":{"type":"boolean","default":false,"description":"Steuert, ob erzwungene Pushes (mit oder ohne Lease) aktiviert sind."},"git.useForcePushWithLease":{"type":"boolean","default":true,"description":"Steuert, ob erzwungene Pushes die sicherere Variante mit Leases verwenden."},"git.useForcePushIfIncludes":{"type":"boolean","default":true,"markdownDescription":"Steuert, ob erzwungene Pushes die sicherere Variante mit force-if-includes verwenden. Hinweis: Für diese Einstellung muss die Einstellung \"#git.useForcePushWithLease#\" aktiviert sein. Zudem ist Git-Version 2.30.0 oder höher erforderlich."},"git.confirmForcePush":{"type":"boolean","default":true,"description":"Steuert, ob der Benutzer vor einem erzwungenen Push zur Bestätigung aufgefordert wird."},"git.allowNoVerifyCommit":{"type":"boolean","default":false,"description":"Hiermit wird gesteuert, ob Commits ohne Ausführung von pre-commit- und commit-msg-Hooks zulässig sind."},"git.confirmNoVerifyCommit":{"type":"boolean","default":true,"description":"Steuert, ob vor dem Committen eine Bestätigung ohne Überprüfung angefragt werden soll."},"git.closeDiffOnOperation":{"type":"boolean","scope":"resource","default":false,"description":"Steuert, ob der Diff-Editor automatisch geschlossen werden soll, wenn Änderungen gestasht, zugesagt, verworfen, bereitgestellt oder nicht bereitgestellt werden."},"git.openDiffOnClick":{"type":"boolean","scope":"resource","default":true,"description":"Steuert, ob der Diff-Editor geöffnet werden soll, wenn Sie auf eine Änderung klicken. Ansonsten wird der normale Editor geöffnet."},"git.supportCancellation":{"type":"boolean","scope":"resource","default":false,"description":"Steuert, ob bei Ausführung der Synchronisierungsaktion eine Benachrichtigung angezeigt wird, sodass der Benutzer den Vorgang abbrechen kann."},"git.branchSortOrder":{"type":"string","enum":["committerdate","alphabetically"],"default":"committerdate","description":"Steuert die Sortierreihenfolge für Branches."},"git.untrackedChanges":{"type":"string","enum":["mixed","separate","hidden"],"enumDescriptions":["Alle Änderungen (nachverfolgte und nicht nachverfolgte) werden zusammen angezeigt und verhalten sich identisch.","Nicht nachverfolgte Änderungen werden separat in der Quellcodeverwaltung angezeigt. Sie sind zudem von mehreren Aktionen ausgeschlossen.","Nicht nachverfolgte Änderungen werden ausgeblendet und von mehreren Aktionen ausgeschlossen."],"default":"mixed","description":"Legt fest, wie sich nicht nachverfolgte Änderungen verhalten.","scope":"resource"},"git.requireGitUserConfig":{"type":"boolean","description":"Steuert, ob eine explizite Git-Benutzerkonfiguration erforderlich ist oder ob Git Annahmen treffen soll, falls die Konfiguration fehlt.","default":true,"scope":"resource"},"git.showCommitInput":{"type":"boolean","scope":"resource","default":true,"description":"Steuert, ob die Commiteingabe im Panel für die Git-Quellcodeverwaltung angezeigt wird."},"git.terminalAuthentication":{"type":"boolean","default":true,"description":"Steuert, ob VS Code als Authentifizierungshandler für Git-Prozesse aktiviert werden soll, die im integrierten Terminal erzeugt werden. Hinweis: Terminals müssen neu gestartet werden, damit eine Änderung dieser Einstellung wirksam wird."},"git.terminalGitEditor":{"type":"boolean","default":false,"description":"Steuert, ob VS Code als Git-Editor für Git-Prozesse aktiviert werden soll, die im integrierten Terminal erzeugt werden. Hinweis: Terminals müssen neu gestartet werden, um eine Änderung in dieser Einstellung zu übernehmen."},"git.useCommitInputAsStashMessage":{"type":"boolean","scope":"resource","default":false,"description":"Steuert, ob die Nachricht aus dem Commiteingabefeld als Standardstashnachricht verwendet wird."},"git.useIntegratedAskPass":{"type":"boolean","default":true,"description":"Steuert, ob GIT_ASKPASS überschrieben werden soll, um die integrierte Version zu verwenden."},"git.githubAuthentication":{"markdownDeprecationMessage":"This setting is now deprecated, please use `#github.gitAuthentication#` instead."},"git.timeline.date":{"type":"string","enum":["committed","authored"],"enumDescriptions":["Commitdatum verwenden","Erstellungsdatum verwenden"],"default":"committed","description":"Steuert, welches Datum für Elemente in der Zeitachsenansicht verwendet werden soll.","scope":"window"},"git.timeline.showAuthor":{"type":"boolean","default":true,"description":"Steuert, ob der Commitautor in der Zeitachsenansicht angezeigt wird.","scope":"window"},"git.timeline.showUncommitted":{"type":"boolean","default":false,"description":"Steuert, ob der Commitautor in der Zeitachsenansicht angezeigt wird.","scope":"window"},"git.showActionButton":{"type":"object","additionalProperties":false,"description":"Steuert, ob eine Aktionsschaltfläche in der Quellensteuerungsansicht angezeigt wird.","properties":{"commit":{"type":"boolean","description":"Zeigen Sie eine Aktionsschaltfläche zum Übertragen von Änderungen an, wenn der lokale Zweig geänderte Dateien enthält, die zum Übertragen bereit sind."},"publish":{"type":"boolean","description":"Zeigen Sie eine Aktionsschaltfläche an, um den lokalen Branch zu veröffentlichen, wenn er keinen verfolgenden Remote Branch hat."},"sync":{"type":"boolean","description":"Zeigen Sie eine Aktionsschaltfläche zum Synchronisieren von Änderungen an, wenn der lokale Zweig entweder vor oder hinter dem entfernten Zweig liegt."}},"default":{"commit":true,"publish":true,"sync":true},"scope":"resource"},"git.statusLimit":{"type":"number","scope":"resource","default":10000,"description":"Steuert, wie die Anzahl der Änderungen begrenzt wird, die über den Git-Statusbefehl analysiert werden können. Kann auf 0 (Null) festgelegt werden, um keinen Grenzwert zu setzen."},"git.repositoryScanIgnoredFolders":{"type":"array","items":{"type":"string"},"default":["node_modules"],"scope":"resource","markdownDescription":"Liste der Ordner, die beim Scannen nach Git-Repositorys ignoriert werden, wenn „#git.autoRepositoryDetection#“ auf „TRUE“ oder „subFolders“ festgelegt ist."},"git.repositoryScanMaxDepth":{"type":"number","scope":"resource","default":1,"markdownDescription":"Steuert die Tiefe, die beim Überprüfen von Arbeitsbereichsordnern für Git-Repositorys verwendet wird, wenn „#git.autoRepositoryDetection#“ auf „TRUE“ oder „subFolders“ festgelegt ist. Kann auf „-1“ festgelegt werden, wenn kein Limit gelten soll."},"git.commandsToLog":{"type":"array","items":{"type":"string"},"default":[],"markdownDescription":"Liste der Git-Befehle (z. B. Commit, Push), deren „stdout“ in der [Git-Ausgabe](command:git.showOutput) protokolliert werden würde. Wenn für den Git-Befehl ein clientseitiger Hook konfiguriert ist, wird „stdout“ des clientseitigen Hooks auch in der [Git-Ausgabe](command:git.showOutput) protokolliert."},"git.mergeEditor":{"type":"boolean","default":false,"markdownDescription":"Den Zusammenführungseditor für Dateien öffnen, die derzeit in Konflikt stehen.","scope":"window"},"git.optimisticUpdate":{"type":"boolean","default":true,"markdownDescription":"Steuert, ob der Status der Quellcodeverwaltungsansicht nach dem Ausführen von Git-Befehlen optimistisch aktualisiert werden soll.","scope":"resource","tags":["experimental"]},"git.openRepositoryInParentFolders":{"type":"string","enum":["always","never","prompt"],"enumDescriptions":["Öffnen Sie immer ein Repository in übergeordneten Ordnern von Arbeitsbereichen, oder öffnen Sie Dateien.","Öffnen Sie niemals ein Repository in übergeordneten Ordnern von Arbeitsbereichen, oder öffnen Sie Dateien.","Fordern Sie vor dem Öffnen eines Repositorys die übergeordneten Ordner von Arbeitsbereichen an, oder öffnen Sie Dateien."],"default":"prompt","markdownDescription":"Steuern Sie, ob ein Repository in übergeordneten Ordnern von Arbeitsbereichen oder geöffneten Dateien geöffnet werden soll.","scope":"resource"},"git.similarityThreshold":{"type":"number","default":50,"minimum":0,"maximum":100,"markdownDescription":"Steuert den Schwellenwert des Ähnlichkeitsindexes (die Anzahl der Hinzufügungen/Löschungen im Vergleich zur Dateigröße), ab dem Änderungen in einem Paar hinzugefügter/gelöschter Dateien als Umbenennung betrachtet werden. **Hinweis:** Erfordert Git-Version 2.18.0 oder höher.","scope":"resource"},"git.blame.editorDecoration.enabled":{"type":"boolean","default":false,"markdownDescription":"Steuert, ob Blame-Informationen mithilfe von Editordekorationen im Editor angezeigt werden."},"git.blame.editorDecoration.template":{"type":"string","default":"${subject}, ${authorName} (${authorDateAgo})","markdownDescription":"Vorlage für die Editor-Dekoration der Blame-Informationen. Unterstützte Variablen:\r\n\r\n* ‚hash‘: Hash committen\r\n\r\n* ‚hashShort‘: Erste N Zeichen des Commithash gemäß ‚#git.commitShortHashLength#‘\r\n\r\n* ‚subject‘: Erste Zeile der Commitnachricht\r\n\r\n* ‚authorName‘: Name des Autors\r\n\r\n* ‚authorEmail‘: E-Mail-Adresse des Autors\r\n\r\n* ‚authorDate‘: Erstellungsdatum\r\n\r\n* ‚authorDateAgo‘: Zeitunterschied zwischen jetzt und Erstellungsdatum\r\n\r\n"},"git.blame.editorDecoration.disableHover":{"type":"boolean","default":false,"markdownDescription":"Steuert, ob die Hover-Dekoration für die Blame-Informationen im Editor deaktiviert wird."},"git.blame.statusBarItem.enabled":{"type":"boolean","default":true,"markdownDescription":"Steuert, ob Blame-Informationen in der Statusleiste angezeigt werden."},"git.blame.statusBarItem.template":{"type":"string","default":"${authorName} (${authorDateAgo})","markdownDescription":"Vorlage für das Statusleistenelement für Blame-Informationen. Unterstützte Variablen:\r\n\r\n* ‚hash‘: Hash committen\r\n\r\n* ‚hashShort‘: Erste N Zeichen des Commithash gemäß ‚#git.commitShortHashLength#‘\r\n\r\n* ‚subject‘: Erste Zeile der Commitnachricht\r\n\r\n* ‚authorName‘: Name des Autors\r\n\r\n* ‚authorEmail‘: E-Mail-Adresse des Autors\r\n\r\n* ‚authorDate‘: Erstellungsdatum\r\n\r\n* ‚authorDateAgo‘: Zeitunterschied zwischen jetzt und Erstellungsdatum\r\n\r\n"},"git.blame.ignoreWhitespace":{"type":"boolean","default":false,"markdownDescription":"Steuert, ob Leerzeichenänderungen bei der Berechnung der Blame-Informationen ignoriert werden."},"git.commitShortHashLength":{"type":"number","default":7,"minimum":7,"maximum":40,"markdownDescription":"Steuert die Länge des kurzen Commithashs.","scope":"resource"},"git.diagnosticsCommitHook.enabled":{"type":"boolean","default":false,"markdownDescription":"Steuert, ob vor dem Commit auf nicht aufgelöste Diagnosen überprüft werden soll.","scope":"resource"},"git.diagnosticsCommitHook.sources":{"type":"object","additionalProperties":{"type":"string","enum":["error","warning","information","hint","none"]},"default":{"*":"error"},"markdownDescription":"Steuert die Liste der Quellen (**Element**) und den Mindestschweregrad (**Wert**), die vor dem Commit berücksichtigt werden sollen. **Hinweis:** Um Diagnosen aus einer bestimmten Quelle zu ignorieren, fügen Sie die Quelle zur Liste hinzu, und setzen Sie den Mindestschweregrad auf \"„kein“.","scope":"resource"},"git.discardUntrackedChangesToTrash":{"type":"boolean","default":true,"markdownDescription":"Steuert, ob das Verwerfen nicht nachverfolgter Änderungen die Dateien in den Papierkorb (Windows), Papierkorb (macOS, Linux) verschiebt, anstatt sie dauerhaft zu löschen. **Hinweis:** Diese Einstellung hat keine Auswirkungen, wenn eine Verbindung mit einem Remotecomputer besteht oder bei Ausführung in Linux als Snap-Paket."},"git.showReferenceDetails":{"type":"boolean","default":true,"markdownDescription":"Steuert, ob die Details des letzten Commits für Git-Referenzen in den Auswahlfeldern für Check-Out, Branch und Tag angezeigt werden."}}},"colors":[{"id":"gitDecoration.addedResourceForeground","description":"Farbe für hinzugefügte Ressourcen.","defaults":{"light":"#587c0c","dark":"#81b88b","highContrast":"#a1e3ad","highContrastLight":"#374e06"}},{"id":"gitDecoration.modifiedResourceForeground","description":"Farbe für geänderte Ressourcen.","defaults":{"light":"#895503","dark":"#E2C08D","highContrast":"#E2C08D","highContrastLight":"#895503"}},{"id":"gitDecoration.deletedResourceForeground","description":"Farbe für gelöschte Ressourcen.","defaults":{"light":"#ad0707","dark":"#c74e39","highContrast":"#c74e39","highContrastLight":"#ad0707"}},{"id":"gitDecoration.renamedResourceForeground","description":"Farbe für umbenannte oder kopierte Ressourcen.","defaults":{"light":"#007100","dark":"#73C991","highContrast":"#73C991","highContrastLight":"#007100"}},{"id":"gitDecoration.untrackedResourceForeground","description":"Farbe für nicht verfolgte Ressourcen.","defaults":{"light":"#007100","dark":"#73C991","highContrast":"#73C991","highContrastLight":"#007100"}},{"id":"gitDecoration.ignoredResourceForeground","description":"Farbe für ignorierte Ressourcen.","defaults":{"light":"#8E8E90","dark":"#8C8C8C","highContrast":"#A7A8A9","highContrastLight":"#8e8e90"}},{"id":"gitDecoration.stageModifiedResourceForeground","description":"Farbe für geänderte Ressourcen, die gestaget wurden.","defaults":{"light":"#895503","dark":"#E2C08D","highContrast":"#E2C08D","highContrastLight":"#895503"}},{"id":"gitDecoration.stageDeletedResourceForeground","description":"Farbe für gelöschte Ressourcen, die gestaget wurden.","defaults":{"light":"#ad0707","dark":"#c74e39","highContrast":"#c74e39","highContrastLight":"#ad0707"}},{"id":"gitDecoration.conflictingResourceForeground","description":"Farbe für Ressourcen mit Konflikten.","defaults":{"light":"#ad0707","dark":"#e4676b","highContrast":"#c74e39","highContrastLight":"#ad0707"}},{"id":"gitDecoration.submoduleResourceForeground","description":"Farbe für Submodul-Ressourcen.","defaults":{"light":"#1258a7","dark":"#8db9e2","highContrast":"#8db9e2","highContrastLight":"#1258a7"}},{"id":"git.blame.editorDecorationForeground","description":"Farbe für die Dekoration des Blame-Editors.","defaults":{"dark":"editorInlayHint.foreground","light":"editorInlayHint.foreground","highContrast":"editorInlayHint.foreground","highContrastLight":"editorInlayHint.foreground"}}],"configurationDefaults":{"[git-commit]":{"editor.rulers":[50,72],"editor.wordWrap":"off","workbench.editor.restoreViewState":false},"[git-rebase]":{"workbench.editor.restoreViewState":false}},"viewsWelcome":[{"view":"scm","contents":"Wenn Sie Git-Features verwenden möchten, aktivieren Sie Git in Ihren [Einstellungen](command:workbench.action.openSettings?%5B%22git.enabled%22%5D).\r\nWeitere Informationen zur Verwendung von Git und der Quellcodeverwaltung in VS Code [finden Sie in unserer Dokumentation](https://aka.ms/vscode-scm).","when":"!config.git.enabled"},{"view":"scm","contents":"Installieren Sie Git, ein beliebtes Quellcodeverwaltungssystem, um Codeänderungen nachzuverfolgen und mit anderen zusammenzuarbeiten. Weitere Informationen finden Sie in unseren [Git-Leitfäden](https://aka.ms/vscode-scm).","when":"config.git.enabled && git.missing && remoteName != ''"},{"view":"scm","contents":"[Git für macOS herunterladen](https://git-scm.com/download/mac)\r\nNach der Installation bitte [neu laden](command:workbench.action.reloadWindow) (oder [Fehlerbehebung](command:git.showOutput)). Zusätzliche Quellcodeverwaltungsanbieter können [aus dem Marketplace](command:workbench.extensions.search?%22%40category%3A%5C%22scm%20providers%5C%22%22) installiert werden.","when":"config.git.enabled && git.missing && remoteName == '' && isMac"},{"view":"scm","contents":"[Git für Windows herunterladen](https://git-scm.com/download/win)\r\nNach der Installation bitte [neu laden](command:workbench.action.reloadWindow) (oder [Fehlerbehebung](command:git.showOutput)). Zusätzliche Quellcodeverwaltungsanbieter können [aus dem Marketplace](command:workbench.extensions.search?%22%40category%3A%5C%22scm%20providers%5C%22%22) installiert werden.","when":"config.git.enabled && git.missing && remoteName == '' && isWindows"},{"view":"scm","contents":"Die Quellcodeverwaltung hängt davon ab, ob Git installiert wird.\r\n[Git für Linux herunterladen](https://git-scm.com/download/linux)\r\nNach der Installation bitte [neu laden](command:workbench.action.reloadWindow) (oder [troubleshoot](command:git.showOutput)). Zusätzliche Quellcodeanbieter können [aus dem Marketplace](command:workbench.extensions.search?%22%40category%3A%5C%22scm%20providers%5C%22%22) installiert werden.","when":"config.git.enabled && git.missing && remoteName == '' && isLinux"},{"view":"scm","contents":"Um Git-Features zu verwenden, können Sie einen Ordner mit einem Git-Repository öffnen oder ein Repository aus einer URL klonen.\r\n[Ordner öffnen](command:vscode.openFolder)\r\n[Repository klonen](command:git.cloneRecursive)\r\nWeitere Informationen zur Verwendung von Git und der Quellcodeverwaltung in VS Code [finden Sie in unserer Dokumentation](https://aka.ms/vscode-scm).","when":"config.git.enabled && !git.missing && workbenchState == empty && git.parentRepositoryCount == 0 && git.unsafeRepositoryCount == 0 && git.closedRepositoryCount == 0","enablement":"git.state == initialized","group":"2_open@1"},{"view":"scm","contents":"Der zurzeit geöffnete Arbeitsbereich enthält keine Ordner mit Git-Repositorys.\r\n[Ordner zum Arbeitsbereich hinzufügen](command:workbench.action.addRootFolder)\r\nWeitere Informationen zur Verwendung von Git und der Quellcodeverwaltung in VS Code [finden Sie in unserer Dokumentation](https://aka.ms/vscode-scm).","when":"config.git.enabled && !git.missing && workbenchState == workspace && workspaceFolderCount == 0 && git.parentRepositoryCount == 0 && git.unsafeRepositoryCount == 0 && git.closedRepositoryCount == 0","enablement":"git.state == initialized","group":"2_open@1"},{"view":"scm","contents":"Der Ordner wird auf Git-Repositorys überprüft...","when":"config.git.enabled && !git.missing && workbenchState == folder && workspaceFolderCount != 0 && git.state != initialized"},{"view":"scm","contents":"Arbeitsbereich wird auf Git-Repositorys überprüft...","when":"config.git.enabled && !git.missing && workbenchState == workspace && workspaceFolderCount != 0 && git.state != initialized"},{"view":"scm","contents":"Der zurzeit geöffnete Ordner enthält kein Git-Repository. Sie können ein Repository initialisieren, wodurch die Git-Features zur Quellcodeverwaltung aktiviert werden.\r\n[Repository initialisieren](command:git.init?%5Btrue%5D)\r\nWeitere Informationen zur Verwendung von Git und der Quellcodeverwaltung in VS Code [finden Sie in unserer Dokumentation](https://aka.ms/vscode-scm).","when":"config.git.enabled && !git.missing && git.state == initialized && workbenchState == folder && scm.providerCount == 0 && git.parentRepositoryCount == 0 && git.unsafeRepositoryCount == 0 && git.closedRepositoryCount == 0 && remoteName != 'codespaces'","group":"5_scm@1"},{"view":"scm","contents":"Der zurzeit geöffnete Arbeitsbereich enthält keine Ordner mit Git-Repositorys. Sie können ein Repository für einen Ordner initialisieren, wodurch die Git-Features zur Quellcodeverwaltung aktiviert werden.\r\n[Repository initialisieren](command:git.init)\r\nWeitere Informationen zur Verwendung von Git und der Quellcodeverwaltung in VS Code [finden Sie in unserer Dokumentation](https://aka.ms/vscode-scm).","when":"config.git.enabled && !git.missing && git.state == initialized && workbenchState == workspace && workspaceFolderCount != 0 && scm.providerCount == 0 && git.parentRepositoryCount == 0 && git.unsafeRepositoryCount == 0 && git.closedRepositoryCount == 0 && remoteName != 'codespaces'","group":"5_scm@1"},{"view":"scm","contents":"Ein Git-Repository wurde in den übergeordneten Ordnern des Arbeitsbereichs oder der geöffneten Datei(en) gefunden.\r\n[Repository öffnen](command:git.openRepositoriesInParentFolders)\r\nVerwenden Sie die Einstellung [git.openRepositoryInParentFolders](command:workbench.action.openSettings?%5B%22git.openRepositoryInParentFolders%22%5D), um zu steuern, ob Git-Repositorys in übergeordneten Ordnern von Arbeitsbereichen oder offenen Dateien geöffnet werden. Weitere Informationen finden Sie [in unserer Dokumentation](https://aka.ms/vscode-git-repository-in-parent-folders).","when":"config.git.enabled && !git.missing && git.state == initialized && git.parentRepositoryCount == 1"},{"view":"scm","contents":"Git-Repositorys wurden in den übergeordneten Ordnern des Arbeitsbereichs oder der geöffneten Datei(en) gefunden.\r\n[Repository öffnen](command:git.openRepositoriesInParentFolders)\r\nVerwenden Sie die Einstellung [git.openRepositoryInParentFolders](command:workbench.action.openSettings?%5B%22git.openRepositoryInParentFolders%22%5D), um zu steuern, ob Git-Repositorys in übergeordneten Ordnern von Arbeitsbereichen oder offenen Dateien geöffnet werden. Weitere Informationen finden Sie [in unserer Dokumentation](https://aka.ms/vscode-git-repository-in-parent-folders).","when":"config.git.enabled && !git.missing && git.state == initialized && git.parentRepositoryCount > 1"},{"view":"scm","contents":"Das erkannte Git-Repository ist potenziell unsicher, weil sich der Ordner im Besitz einer anderen Person als dem aktuellen Benutzer befindet.\r\n[Unsichere Repositorys verwalten](command:git.manageUnsafeRepositories)\r\nWeitere Informationen zu unsicheren Repositorys finden Sie in [unserer Dokumentation](https://aka.ms/vscode-git-unsafe-repository).","when":"config.git.enabled && !git.missing && git.state == initialized && git.unsafeRepositoryCount == 1"},{"view":"scm","contents":"Die erkannten Git-Repositorys sind potenziell unsicher, weil sich die Ordner im Besitz einer anderen Person als dem aktuellen Benutzer befinden.\r\n[Unsichere Repositorys verwalten](command:git.manageUnsafeRepositories)\r\nWeitere Informationen zu unsicheren Repositorys finden Sie in [unserer Dokumentation](https://aka.ms/vscode-git-unsafe-repository).","when":"config.git.enabled && !git.missing && git.state == initialized && git.unsafeRepositoryCount > 1"},{"view":"scm","contents":"Es wurde ein Git-Repository gefunden, das zuvor geschlossen wurde.\r\n[Geschlossenes Repository erneut öffnen](command:git.reopenClosedRepositories)\r\nWeitere Informationen zur Verwendung von Git und der Quellcodeverwaltung in VS Code [finden Sie in unserer Dokumentation](https://aka.ms/vscode-scm).","when":"config.git.enabled && !git.missing && git.state == initialized && git.closedRepositoryCount == 1"},{"view":"scm","contents":"Es wurden Git-Repositorys gefunden, die zuvor geschlossen wurden.\r\n[Geschlossene Repositorys erneut öffnen](command:git.reopenClosedRepositories)\r\nWeitere Informationen zur Verwendung von Git und der Quellcodeverwaltung in VS Code [finden Sie in unserer Dokumentation](https://aka.ms/vscode-scm).","when":"config.git.enabled && !git.missing && git.state == initialized && git.closedRepositoryCount > 1"},{"view":"explorer","contents":"Sie können ein Repository lokal klonen.\r\n[Repository klonen](command:git.clone 'Clone a repository once the git extension has activated')","when":"config.git.enabled && git.state == initialized && scm.providerCount == 0","group":"5_scm@1"},{"view":"explorer","contents":"Weitere Informationen zur Verwendung von Git und der Quellcodeverwaltung in VS Code [finden Sie in unserer Dokumentation](https://aka.ms/vscode-scm).","when":"config.git.enabled && git.state == initialized && scm.providerCount == 0","group":"5_scm@10"}]},"repository":{"type":"git","url":"https://github.com/microsoft/vscode.git"},"allowScripts":{"@vscode/fs-copyfile@2.0.0":true},"originalEnabledApiProposals":["agentSessionsWorkspace","agentsWindowConfiguration","canonicalUriProvider","contribEditSessions","contribEditorContentMenu","contribMergeEditorMenus","contribMultiDiffEditorMenus","contribDiffEditorGutterToolBarMenus","contribSourceControlArtifactGroupMenu","contribSourceControlArtifactMenu","contribSourceControlHistoryItemMenu","contribSourceControlHistoryTitleMenu","contribSourceControlInputBoxMenu","contribSourceControlTitleMenu","contribViewsWelcome","editSessionIdentityProvider","envIsConnectionMetered","findFiles2","quickDiffProvider","quickPickSortByLabel","scmActionButton","scmArtifactProvider","scmHistoryProvider","scmMultiDiffEditor","scmProviderOptions","scmSelectedProvider","scmTextDocument","scmValidation","statusBarItemTooltip","taskRunOptions","tabInputMultiDiff","tabInputTextMerge","textEditorDiffInformation","timeline","workspaceTrust"]},"location":{"$mid":1,"path":"/data/data/com.termux/files/usr/lib/code-oss/resources/app/extensions/git","scheme":"file"},"isBuiltin":true,"targetPlatform":"undefined","isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":0,"identifier":{"id":"vscode.git-base"},"manifest":{"name":"git-base","displayName":"Git-Basis","description":"Statische Git-Beiträge und -Auswahl.","version":"10.0.0","publisher":"vscode","license":"MIT","engines":{"vscode":"0.10.x"},"categories":["Other"],"activationEvents":["*"],"main":"./dist/extension.js","browser":"./dist/browser/extension.js","icon":"resources/icons/git.png","capabilities":{"virtualWorkspaces":true,"untrustedWorkspaces":{"supported":true}},"contributes":{"commands":[{"command":"git-base.api.getRemoteSources","title":{"value":"Remotequellen abrufen","original":"Get Remote Sources"},"category":"Git Base API"}],"menus":{"commandPalette":[{"command":"git-base.api.getRemoteSources","when":"false"}]},"languages":[{"id":"git-commit","aliases":["Git Commit Message","git-commit"],"filenames":["COMMIT_EDITMSG","MERGE_MSG"],"configuration":"./languages/git-commit.language-configuration.json"},{"id":"git-rebase","aliases":["Git Rebase Message","git-rebase"],"filenames":["git-rebase-todo"],"filenamePatterns":["**/rebase-merge/done"],"configuration":"./languages/git-rebase.language-configuration.json"},{"id":"ignore","aliases":["Ignore","ignore"],"extensions":[".gitignore_global",".gitignore",".git-blame-ignore-revs"],"configuration":"./languages/ignore.language-configuration.json"}],"grammars":[{"language":"git-commit","scopeName":"text.git-commit","path":"./syntaxes/git-commit.tmLanguage.json"},{"language":"git-rebase","scopeName":"text.git-rebase","path":"./syntaxes/git-rebase.tmLanguage.json"},{"language":"ignore","scopeName":"source.ignore","path":"./syntaxes/ignore.tmLanguage.json"}]},"repository":{"type":"git","url":"https://github.com/microsoft/vscode.git"}},"location":{"$mid":1,"path":"/data/data/com.termux/files/usr/lib/code-oss/resources/app/extensions/git-base","scheme":"file"},"isBuiltin":true,"targetPlatform":"undefined","isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":0,"identifier":{"id":"vscode.github"},"manifest":{"name":"github","displayName":"GitHub","description":"GitHub-Features für VS Code","publisher":"vscode","license":"MIT","version":"0.0.1","engines":{"vscode":"^1.41.0"},"aiKey":"0c6ae279ed8443289764825290e4f9e2-1a736e7c-1324-4338-be46-fc2a58ae4d14-7255","icon":"images/icon.png","categories":["Other"],"activationEvents":["*"],"extensionDependencies":["vscode.git-base"],"type":"module","main":"./dist/extension.js","capabilities":{"virtualWorkspaces":true,"untrustedWorkspaces":{"supported":true}},"enabledApiProposals":["canonicalUriProvider","chatSessionsProvider","contribEditSessions","contribShareMenu","contribSourceControlHistoryItemMenu","scmHistoryProvider","shareProvider","timeline"],"contributes":{"commands":[{"command":"github.publish","title":{"value":"In GitHub veröffentlichen","original":"Publish to GitHub"}},{"command":"github.copyVscodeDevLink","title":{"value":"Vscode.dev-Link kopieren","original":"Copy vscode.dev Link"}},{"command":"github.copyVscodeDevLinkFile","title":{"value":"Vscode.dev-Link kopieren","original":"Copy vscode.dev Link"}},{"command":"github.copyVscodeDevLinkWithoutRange","title":{"value":"Vscode.dev-Link kopieren","original":"Copy vscode.dev Link"}},{"command":"github.openOnVscodeDev","title":{"value":"In vscode.dev öffnen","original":"Open in vscode.dev"},"icon":"$(globe)"},{"command":"github.graph.openOnGitHub","title":{"value":"In GitHub öffnen","original":"Open on GitHub"},"icon":"$(github)"},{"command":"github.timeline.openOnGitHub","title":{"value":"In GitHub öffnen","original":"Open on GitHub"},"icon":"$(github)"},{"command":"github.createPullRequest","title":{"value":"Pull Request erstellen","original":"Create PR"},"icon":"$(git-pull-request)"},{"command":"github.openPullRequest","title":{"value":"Pull Request öffnen","original":"Open PR"},"icon":"$(git-pull-request)"}],"continueEditSession":[{"command":"github.openOnVscodeDev","when":"github.hasGitHubRepo","qualifiedName":"Continue Working in vscode.dev","category":"Remote Repositories","remoteGroup":"virtualfs_44_vscode-vfs_2_web@2"}],"menus":{"commandPalette":[{"command":"github.publish","when":"git-base.gitEnabled && workspaceFolderCount != 0 && remoteName != 'codespaces'"},{"command":"github.createPullRequest","when":"false"},{"command":"github.openPullRequest","when":"false"},{"command":"github.graph.openOnGitHub","when":"false"},{"command":"github.copyVscodeDevLink","when":"false"},{"command":"github.copyVscodeDevLinkFile","when":"false"},{"command":"github.copyVscodeDevLinkWithoutRange","when":"false"},{"command":"github.openOnVscodeDev","when":"false"},{"command":"github.timeline.openOnGitHub","when":"false"}],"file/share":[{"command":"github.copyVscodeDevLinkFile","when":"github.hasGitHubRepo && remoteName != 'codespaces'","group":"0_vscode@0"}],"editor/context/share":[{"command":"github.copyVscodeDevLink","when":"github.hasGitHubRepo && resourceScheme != untitled && !isInEmbeddedEditor && remoteName != 'codespaces'","group":"0_vscode@0"}],"explorer/context/share":[{"command":"github.copyVscodeDevLinkWithoutRange","when":"github.hasGitHubRepo && resourceScheme != untitled && !isInEmbeddedEditor && remoteName != 'codespaces'","group":"0_vscode@0"}],"editor/lineNumber/context":[{"command":"github.copyVscodeDevLink","when":"github.hasGitHubRepo && resourceScheme != untitled && activeEditor == workbench.editors.files.textFileEditor && config.editor.lineNumbers == on && remoteName != 'codespaces'","group":"1_cutcopypaste@2"},{"command":"github.copyVscodeDevLink","when":"github.hasGitHubRepo && resourceScheme != untitled && activeEditor == workbench.editor.notebook && remoteName != 'codespaces'","group":"1_cutcopypaste@2"}],"editor/title/context/share":[{"command":"github.copyVscodeDevLinkWithoutRange","when":"github.hasGitHubRepo && resourceScheme != untitled && remoteName != 'codespaces'","group":"0_vscode@0"}],"scm/historyItem/context":[{"command":"github.graph.openOnGitHub","when":"github.hasGitHubRepo","group":"0_view@2"}],"timeline/item/context":[{"command":"github.timeline.openOnGitHub","group":"1_actions@3","when":"github.hasGitHubRepo && timelineItem =~ /git:file:commit\\b/"}],"agents/changes/actions/primary":[]},"configuration":[{"title":"GitHub","properties":{"github.branchProtection":{"type":"boolean","scope":"resource","default":true,"description":"Steuert, ob Repositoryregeln für GitHub-Repositorys abgefragt werden"},"github.gitAuthentication":{"type":"boolean","scope":"resource","default":true,"description":"Steuert, ob die automatische GitHub-Authentifizierung für Git-Befehle innerhalb von VS Code aktiviert werden soll."},"github.gitProtocol":{"type":"string","enum":["https","ssh"],"default":"https","description":"Steuert, welches Protokoll zum Klonen eines GitHub-Repositorys verwendet wird"},"github.showAvatar":{"type":"boolean","scope":"resource","default":true,"description":"Steuert, ob der GitHub-Avatar des Commitautors in verschiedenen Hovers angezeigt werden soll (z. B. Git Blame, Timeline, Source Control Graph usw.)."}}}],"viewsWelcome":[{"view":"scm","contents":"Sie können diesen Ordner direkt in einem GitHub-Repository veröffentlichen. Nach der Veröffentlichung haben Sie Zugriff auf die Funktionen zur Quellcodeverwaltung von Git und GitHub.\r\n[$(github): Veröffentlichung in GitHub](command:github.publish)","when":"config.git.enabled && git.state == initialized && workbenchState == folder && git.parentRepositoryCount == 0 && git.unsafeRepositoryCount == 0 && git.closedRepositoryCount == 0"},{"view":"scm","contents":"Sie können einen Arbeitsbereichsordner direkt in einem GitHub-Repository veröffentlichen. Nach der Veröffentlichung haben Sie Zugriff auf die Funktionen zur Quellcodeverwaltung von Git und GitHub.\r\n[$(github): Veröffentlichung in GitHub](command:github.publish)","when":"config.git.enabled && git.state == initialized && workbenchState == workspace && workspaceFolderCount != 0 && git.parentRepositoryCount == 0 && git.unsafeRepositoryCount == 0 && git.closedRepositoryCount == 0"}],"markdown.previewStyles":["./markdown.css"]},"repository":{"type":"git","url":"https://github.com/microsoft/vscode.git"},"originalEnabledApiProposals":["canonicalUriProvider","chatSessionsProvider","contribEditSessions","contribShareMenu","contribSourceControlHistoryItemMenu","scmHistoryProvider","shareProvider","timeline"]},"location":{"$mid":1,"path":"/data/data/com.termux/files/usr/lib/code-oss/resources/app/extensions/github","scheme":"file"},"isBuiltin":true,"targetPlatform":"undefined","isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":0,"identifier":{"id":"vscode.github-authentication"},"manifest":{"name":"github-authentication","displayName":"GitHub-Authentifizierung","description":"GitHub-Authentifizierungsanbieter","publisher":"vscode","license":"MIT","version":"0.0.2","engines":{"vscode":"^1.41.0"},"icon":"images/icon.png","categories":["Other"],"api":"none","extensionKind":["ui","workspace"],"enabledApiProposals":["authIssuers","authProviderSpecific"],"activationEvents":[],"capabilities":{"virtualWorkspaces":true,"untrustedWorkspaces":{"supported":"limited","restrictedConfigurations":["github-enterprise.uri"]}},"contributes":{"authentication":[{"label":"GitHub","id":"github","authorizationServerGlobs":["https://github.com/login/oauth"]},{"label":"GitHub Enterprise Server","id":"github-enterprise","authorizationServerGlobs":["*"]}],"configuration":[{"title":"GHE.com und GitHub Enterprise Serverauthentifizierung","properties":{"github-enterprise.uri":{"type":"string","markdownDescription":"Der URI für ihre GHE.com- oder GitHub Enterprise Server-instance.\r\n\r\nBeispiele:\r\n* GHE.com: 'https://octocat.ghe.com`\r\n* GitHub Enterprise Server: 'https://github.octocat.com`\r\n\r\n> **Hinweis:** Dies sollte _nicht_ auf einen GitHub.com-URI festgelegt werden. Wenn Ihr Konto auf GitHub.com vorhanden ist oder ein GitHub Enterprise verwalteter Benutzer ist, benötigen Sie keine zusätzliche Konfiguration und können sich einfach bei GitHub anmelden.","pattern":"^(?:$|(https?)://(?!github\\.com).*)"},"github-authentication.useElectronFetch":{"type":"boolean","default":true,"scope":"application","markdownDescription":"Bei TRUE wird die integrierte Abruffunktion von Electron für HTTP-Anforderungen verwendet. Bei FALSE wird die globale Abruffunktion von Node.js verwendet