:"package.json","url":"./schemas/package.schema.json"},{"fileMatch":"tsconfig.json","url":"https://www.schemastore.org/tsconfig"},{"fileMatch":"tsconfig.json","url":"./schemas/tsconfig.schema.json"},{"fileMatch":"tsconfig.*.json","url":"https://www.schemastore.org/tsconfig"},{"fileMatch":"tsconfig-*.json","url":"./schemas/tsconfig.schema.json"},{"fileMatch":"tsconfig-*.json","url":"https://www.schemastore.org/tsconfig"},{"fileMatch":"tsconfig.*.json","url":"./schemas/tsconfig.schema.json"},{"fileMatch":"typings.json","url":"https://www.schemastore.org/typings"},{"fileMatch":".bowerrc","url":"https://www.schemastore.org/bowerrc"},{"fileMatch":".babelrc","url":"https://www.schemastore.org/babelrc"},{"fileMatch":".babelrc.json","url":"https://www.schemastore.org/babelrc"},{"fileMatch":"babel.config.json","url":"https://www.schemastore.org/babelrc"},{"fileMatch":"jsconfig.json","url":"https://www.schemastore.org/jsconfig"},{"fileMatch":"jsconfig.json","url":"./schemas/jsconfig.schema.json"},{"fileMatch":"jsconfig.*.json","url":"https://www.schemastore.org/jsconfig"},{"fileMatch":"jsconfig.*.json","url":"./schemas/jsconfig.schema.json"},{"fileMatch":".swcrc","url":"https://swc.rs/schema.json"},{"fileMatch":"typedoc.json","url":"https://typedoc.org/schema.json"}],"configuration":[{"type":"object","properties":{"js/ts.tsdk.path":{"type":"string","markdownDescription":"Gibt den Ordnerpfad zu den tsserver- und `lib*.d.ts`-Dateien unter einer TypeScript-Installation zur Verwendung mit IntelliSense an, zum Beispiel: `./node_modules/typescript/lib`.\r\n\r\n– Sofern als Benutzereinstellung angegeben, ersetzt die TypeScript-Version aus `js/ts.tsdk.path` automatisch die integrierte TypeScript-Version.\r\n– Sofern als Arbeitsbereichseinstellung angegeben, erlaubt Ihnen `js/ts.tsdk.path` mit dem Befehl `TypeScript: Select TypeScript version` zu dieser Arbeitsbereichsversion von TypeScript zu wechseln und sie für IntelliSense zu verwenden.\r\n\r\nWeitere Informationen zum Verwalten von TypeScript-Versionen finden Sie in der [Dokumentation zu TypeScript](https://code.visualstudio.com/docs/typescript/typescript-compiling#_using-newer-typescript-versions).","scope":"window","order":1,"keywords":["TypeScript"]},"typescript.tsdk":{"type":"string","markdownDescription":"Gibt den Ordnerpfad zu den tsserver- und `lib*.d.ts`-Dateien unter einer TypeScript-Installation zur Verwendung mit IntelliSense an, zum Beispiel: `./node_modules/typescript/lib`.\r\n\r\n– Sofern als Benutzereinstellung angegeben, ersetzt die TypeScript-Version aus `js/ts.tsdk.path` automatisch die integrierte TypeScript-Version.\r\n– Sofern als Arbeitsbereichseinstellung angegeben, erlaubt Ihnen `js/ts.tsdk.path` mit dem Befehl `TypeScript: Select TypeScript version` zu dieser Arbeitsbereichsversion von TypeScript zu wechseln und sie für IntelliSense zu verwenden.\r\n\r\nWeitere Informationen zum Verwalten von TypeScript-Versionen finden Sie in der [Dokumentation zu TypeScript](https://code.visualstudio.com/docs/typescript/typescript-compiling#_using-newer-typescript-versions).","markdownDeprecationMessage":"Diese Einstellung ist veraltet. Verwenden Sie stattdessen `#js/ts.tsdk.path#`.","scope":"window","order":1},"js/ts.experimental.useTsgo":{"type":"boolean","default":false,"markdownDescription":"Deaktiviert die Sprachfunktionen von TypeScript und JavaScript, um die Verwendung der experimentellen Erweiterung „TypeScript Go“ zu ermöglichen. Erfordert die Installation und Konfiguration von TypeScript Go. Nach dem Ändern dieser Einstellung müssen die Erweiterungen neu geladen werden.","scope":"window","order":2,"keywords":["TypeScript","experimental"]},"typescript.experimental.useTsgo":{"type":"boolean","default":false,"markdownDescription":"Deaktiviert die Sprachfunktionen von TypeScript und JavaScript, um die Verwendung der experimentellen Erweiterung „TypeScript Go“ zu ermöglichen. Erfordert die Installation und Konfiguration von TypeScript Go. Nach dem Ändern dieser Einstellung müssen die Erweiterungen neu geladen werden.","markdownDeprecationMessage":"Diese Einstellung ist veraltet. Verwenden Sie stattdessen `#js/ts.experimental.useTsgo#`.","scope":"window","order":2,"keywords":["experimental"]},"js/ts.locale":{"type":"string","default":"auto","enum":["auto","de","es","en","fr","it","ja","ko","ru","zh-CN","zh-TW"],"enumDescriptions":["Konfigurierte Anzeigesprache von VS Code verwenden.","Deutsch","español","English","français","italiano","日本語","한국어","русский","中文(简体)","中文(繁體)"],"markdownDescription":"Legt das zum Melden von JavaScript- und TypeScript-Fehlern verwendete Gebietsschema fest. Standardmäßig wird das Gebietsschema von VS Code verwendet.","scope":"window","order":3,"keywords":["TypeScript"]},"typescript.locale":{"type":"string","default":"auto","enum":["auto","de","es","en","fr","it","ja","ko","ru","zh-CN","zh-TW"],"enumDescriptions":["Konfigurierte Anzeigesprache von VS Code verwenden.","Deutsch","español","English","français","italiano","日本語","한국어","русский","中文(简体)","中文(繁體)"],"markdownDescription":"Legt das zum Melden von JavaScript- und TypeScript-Fehlern verwendete Gebietsschema fest. Standardmäßig wird das Gebietsschema von VS Code verwendet.","markdownDeprecationMessage":"Diese Einstellung ist veraltet. Verwenden Sie stattdessen `#js/ts.locale#`.","scope":"window","order":3},"js/ts.tsc.autoDetect":{"type":"string","default":"on","enum":["on","off","build","watch"],"markdownEnumDescriptions":["Build- und Überwachungstasks erstellen","Dieses Feature deaktivieren.","Nur Tasks mit einmaliger Kompilierung erstellen.","Nur Kompilierungs- und Überwachungstasks erstellen."],"description":"Legt fest, ob tsc-Tasks automatisch erkannt werden.","scope":"window","order":4,"keywords":["TypeScript"]},"typescript.tsc.autoDetect":{"type":"string","default":"on","enum":["on","off","build","watch"],"markdownEnumDescriptions":["Build- und Überwachungstasks erstellen","Dieses Feature deaktivieren.","Nur Tasks mit einmaliger Kompilierung erstellen.","Nur Kompilierungs- und Überwachungstasks erstellen."],"description":"Legt fest, ob tsc-Tasks automatisch erkannt werden.","markdownDeprecationMessage":"Diese Einstellung ist veraltet. Verwenden Sie stattdessen `#js/ts.tsc.autoDetect#`.","scope":"window","order":4}}},{"type":"object","title":"Einstellungen","properties":{"js/ts.preferences.quoteStyle":{"type":"string","enum":["auto","single","double"],"default":"auto","markdownDescription":"Bevorzugtes Anführungszeichenformat, das für schnelle Problembehebungen verwendet werden soll.","markdownEnumDescriptions":["Anführungszeichentyp aus vorhandenem Code ableiten","Verwenden Sie immer einfache Anführungszeichen: `'`","Verwenden Sie immer doppelte Anführungszeichen: `\"`"],"scope":"language-overridable","keywords":["JavaScript","TypeScript"]},"javascript.preferences.quoteStyle":{"type":"string","enum":["auto","single","double"],"default":"auto","markdownDescription":"Bevorzugtes Anführungszeichenformat, das für schnelle Problembehebungen verwendet werden soll.","markdownEnumDescriptions":["Anführungszeichentyp aus vorhandenem Code ableiten","Verwenden Sie immer einfache Anführungszeichen: `'`","Verwenden Sie immer doppelte Anführungszeichen: `\"`"],"markdownDeprecationMessage":"Diese Einstellung ist veraltet. Verwenden Sie stattdessen `#js/ts.preferences.quoteStyle#`.","scope":"language-overridable"},"typescript.preferences.quoteStyle":{"type":"string","enum":["auto","single","double"],"default":"auto","markdownDescription":"Bevorzugtes Anführungszeichenformat, das für schnelle Problembehebungen verwendet werden soll.","markdownEnumDescriptions":["Anführungszeichentyp aus vorhandenem Code ableiten","Verwenden Sie immer einfache Anführungszeichen: `'`","Verwenden Sie immer doppelte Anführungszeichen: `\"`"],"markdownDeprecationMessage":"Diese Einstellung ist veraltet. Verwenden Sie stattdessen `#js/ts.preferences.quoteStyle#`.","scope":"language-overridable"},"js/ts.preferences.importModuleSpecifier":{"type":"str