g","activationEvents":["onLanguage:css","onLanguage:less","onLanguage:scss"],"main":"./client/dist/node/cssClientMain","browser":"./client/dist/browser/cssClientMain","capabilities":{"virtualWorkspaces":true,"untrustedWorkspaces":{"supported":true}},"categories":["Programming Languages"],"contributes":{"configuration":[{"order":22,"id":"css","title":"CSS","properties":{"css.customData":{"type":"array","markdownDescription":"Eine Liste relativer Dateipfade, die auf JSON-Dateien im [benutzerdefinierten Datenformat](https://github.com/microsoft/vscode-css-languageservice/blob/master/docs/customData.md) verweisen.\r\n\r\nVS Code lädt benutzerdefinierte Daten beim Start, um die CSS-Unterstützung für benutzerdefinierte CSS-Eigenschaften (Variablen), At-Regeln, Pseudoklassen und Pseudoelemente zu verbessern, die Sie in den JSON-Dateien angeben.\r\n\r\nDie Dateipfade werden relativ zum Arbeitsbereich angegeben und es werden nur Einstellungen für den Arbeitsbereichsordner berücksichtigt.","default":[],"items":{"type":"string"},"scope":"resource"},"css.completion.triggerPropertyValueCompletion":{"type":"boolean","scope":"resource","default":true,"description":"VS Code löst die Vervollständigung des Eigenschaftswerts standardmäßig aus, nachdem eine CSS-Eigenschaft ausgewählt wurde. Mit dieser Einstellung deaktivieren Sie dieses Verhalten."},"css.completion.completePropertyWithSemicolon":{"type":"boolean","scope":"resource","default":true,"description":"Hiermit wird beim Vervollständigen von CSS-Eigenschaften ein Semikolon am Zeilenende eingefügt."},"css.validate":{"type":"boolean","scope":"resource","default":true,"description":"Aktiviert oder deaktiviert alle Überprüfungen."},"css.hover.documentation":{"type":"boolean","scope":"resource","default":true,"description":"Eigenschaften- und Wertdokumentation in CSS-Hovers anzeigen."},"css.hover.references":{"type":"boolean","scope":"resource","default":true,"description":"Hiermit werden bei CSS-Hovers Verweise auf MDN eingeblendet."},"css.lint.compatibleVendorPrefixes":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","description":"Beim Verwenden eines anbieterspezifischen Präfixes sicherstellen, dass alle anderen anbieterspezifischen Eigenschaften einbezogen werden."},"css.lint.vendorPrefix":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"warning","description":"Beim Verwenden eines anbieterspezifischen Präfixes auch die Standardeigenschaft einbeziehen."},"css.lint.duplicateProperties":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","description":"Keine doppelten Formatdefinitionen verwenden."},"css.lint.emptyRules":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"warning","description":"Keine leeren Regelsätze verwenden."},"css.lint.importStatement":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","description":"Import-Anweisungen werden nicht parallel geladen."},"css.lint.boxModel":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","markdownDescription":"\"width\" oder \"height\" nicht verwenden, wenn \"padding\" oder \"border\" genutzt werden."},"css.lint.universalSelector":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","markdownDescription":"Der Universalselektor (*) ist bekanntermaßen langsam."},"css.lint.zeroUnits":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","description":"Keine Einheit für Null erforderlich."},"css.lint.fontFaceProperties":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"warning","markdownDescription":"`@font-face`-Regel muss Eigenschaften `src` und `font-family` definieren."},"css.lint.hexColorLength":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"error","description":"Hexadezimalfarben müssen aus 3, 4, 6 oder 8 Hexadezimalzahlen bestehen."},"css.lint.argumentsInColorFunction":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"error","description":"Ungültige Anzahl von Parametern."},"css.lint.unknownProperties":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"warning","description":"Unbekannte Eigenschaft."},"css.lint.validProperties":{"type":"array","uniqueItems":true,"items":{"type":"string"},"scope":"resource","default":[],"markdownDescription":"Eine Liste der Eigenschaften, die nicht auf Übereinstimmung mit der Regel \"unknownProperties\" überprüft werden."},"css.lint.ieHack":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","description":"IE-Hacks sind nur für die Unterstützung von IE7 und niedriger erforderlich."},"css.lint.unknownVendorSpecificProperties":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","description":"Unbekannte anbieterspezifische Eigenschaft."},"css.lint.propertyIgnoredDueToDisplay":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"warning","markdownDescription":"Die Eigenschaft wird aufgrund der Anzeige ignoriert. Durch die Angabe \"display: inline\" haben beispielsweise die Eigenschaften \"width\", \"height\", \"margin-top\", \"margin-bottom\" und \"float\" keine Auswirkung."},"css.lint.important":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","markdownDescription":"Verwendung von \"!important\" vermeiden. Damit wird angegeben, dass es mit der Spezifität des gesamten CSS-Codes Probleme gibt und eine Umgestaltung erforderlich ist."},"css.lint.float":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","markdownDescription":"Die Verwendung von \"float\" vermeiden. float-Eigenschaften führen leicht dazu, dass CSS nicht mehr funktioniert, wenn sich ein As